rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Somente operadores autenticados (Firebase Auth e-mail/senha) leem e escrevem.
    match /{colecao}/{id} {
      allow read, write: if request.auth != null
        && colecao in ['clientes', 'caiaques', 'passeios'];
    }
  }
}
